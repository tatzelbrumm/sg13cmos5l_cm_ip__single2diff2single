#%lvsdb-klayout

# Layout
layout(
 top(oa_n10)
 unit(0.001)

 # Layer section
 # This section lists the mask layers (drawing or derived) and their connections.

 # Mask layers
 layer(poly '5/0')
 layer(cont '6/0')
 layer(m1 '8/0')
 layer(v1 '19/0')
 layer(m2 '10/0')
 layer(nw '31/0')
 layer(sub)
 layer(t8 '8/25')
 layer(psd_sd)
 layer(nsd_sd)
 layer(ntap)
 layer(ptap)
 layer(t10 '10/25')

 # Mask layer connectivity
 connect(poly poly cont)
 connect(cont poly m1 psd_sd nsd_sd ntap ptap)
 connect(m1 cont m1 v1 t8)
 connect(v1 m1 m2)
 connect(m2 v1 m2 t10)
 connect(nw nw ntap)
 connect(sub sub ptap)
 connect(t8 m1)
 connect(psd_sd cont psd_sd)
 connect(nsd_sd cont nsd_sd)
 connect(ntap cont nw ntap)
 connect(ptap cont sub ptap)
 connect(t10 m2)

 # Device class section
 class(sg13_hv_pmos MOS4)
 class(sg13_hv_nmos MOS4)

 # Device abstracts section
 # Device abstracts list the pin shapes of the devices.
 device(D$sg13_hv_nmos sg13_hv_nmos
  terminal(S
   rect(nsd_sd (-1000 -840) (2000 340))
  )
  terminal(G
   rect(poly (-1000 -500) (2000 1000))
  )
  terminal(D
   rect(nsd_sd (-1000 500) (2000 340))
  )
  terminal(B
   rect(sub (-1000 -500) (2000 1000))
  )
 )
 device(D$sg13_hv_nmos$1 sg13_hv_nmos
  terminal(S
   rect(nsd_sd (-5000 -840) (10000 340))
  )
  terminal(G
   rect(poly (-5000 -500) (10000 1000))
  )
  terminal(D
   rect(nsd_sd (-5000 500) (10000 340))
  )
  terminal(B
   rect(sub (-5000 -500) (10000 1000))
  )
 )
 device(D$sg13_hv_nmos$2 sg13_hv_nmos
  terminal(S
   rect(nsd_sd (-1340 -250) (340 500))
  )
  terminal(G
   rect(poly (-1000 -250) (2000 500))
  )
  terminal(D
   rect(nsd_sd (1000 -250) (340 500))
  )
  terminal(B
   rect(sub (-1000 -250) (2000 500))
  )
 )
 device(D$sg13_hv_nmos$3 sg13_hv_nmos
  terminal(S
   rect(nsd_sd (-565 -500) (340 1000))
  )
  terminal(G
   rect(poly (-225 -500) (450 1000))
  )
  terminal(D
   rect(nsd_sd (225 -500) (340 1000))
  )
  terminal(B
   rect(sub (-225 -500) (450 1000))
  )
 )

