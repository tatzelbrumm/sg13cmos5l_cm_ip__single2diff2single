# Reference netlist
reference(

 # Device class section
 class(SG13_HV_NMOS MOS4)

 # Circuit section
 # Circuits are the hierarchical building blocks of the netlist.
 circuit(oa_mcs_c

  # Nets
  net(1 name(VSS))
  net(2 name(VBR))
  net(3 name(VRES))

  # Outgoing pins and their connections to nets
  pin(1 name(VSS))
  pin(2 name(VBR))
  pin(3 name(VRES))

  # Devices and their connections
  device(1 SG13_HV_NMOS
   name(MCS)
   param(L 30)
   param(W 3.4)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 1)
   terminal(G 2)
   terminal(D 2)
   terminal(B 1)
  )
  device(2 SG13_HV_NMOS
   name(MCL)
   param(L 30)
   param(W 3.4)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 1)
   terminal(G 2)
   terminal(D 3)
   terminal(B 1)
  )

 )
)

# Cross reference
xref(
 circuit(oa_mcs_c oa_mcs_c match
  xref(
   net(1 2 match)
   net(3 3 match)
   net(2 1 match)
   pin(() 1 match)
   pin(() 2 match)
   pin(() 0 match)
   pin(1 () match)
   pin(2 () match)
   pin(0 () match)
   device(2 1 match)
   device(1 2 match)
  )
 )
)
