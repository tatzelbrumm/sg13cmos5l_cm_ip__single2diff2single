# Cross reference
xref(
 circuit(oa_nmir oa_nmir match
  log(
   entry(warning description('Matching nets $2 vs. D10 from an ambiguous group of nets'))
   entry(warning description('Matching nets $3 vs. VRES from an ambiguous group of nets'))
  )
  xref(
   net(2 1 warning)
   net(1 2 match)
   net(3 3 warning)
   net(4 4 match)
   pin(() 0 match)
   pin(() 1 match)
   pin(() 2 match)
   pin(() 3 match)
   pin(0 () match)
   pin(1 () match)
   pin(2 () match)
   pin(3 () match)
   device(3 1 match)
   device(1 2 match)
   device(8 22 match)
  )
 )
)
