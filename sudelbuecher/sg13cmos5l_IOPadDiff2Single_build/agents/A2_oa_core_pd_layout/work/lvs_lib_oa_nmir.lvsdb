# Reference netlist
reference(

 # Device class section
 class(SG13_HV_NMOS MOS4)

 # Circuit section
 # Circuits are the hierarchical building blocks of the netlist.
 circuit(oa_nmir

  # Nets
  net(1 name(D10))
  net(2 name(VNC))
  net(3 name(VRES))
  net(4 name(VSS))

  # Outgoing pins and their connections to nets
  pin(1 name(D10))
  pin(2 name(VNC))
  pin(3 name(VRES))
  pin(4 name(VSS))

  # Devices and their connections
  device(1 SG13_HV_NMOS
   name(OA_NMIR_R1_M11_0)
   param(L 1)
   param(W 90)
   param(AS 0)
   param(AD 0)
