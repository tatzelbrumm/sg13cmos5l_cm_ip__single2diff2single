# Reference netlist
reference(

 # Device class section
 class(SG13_HV_NMOS MOS4)

 # Circuit section
 # Circuits are the hierarchical building blocks of the netlist.
 circuit(oa_mcs

  # Nets
  net(1 name(VBR))
  net(2 name(VRES))
  net(3 name(VSS))

  # Outgoing pins and their connections to nets
  pin(1 name(VBR))
  pin(2 name(VRES))
  pin(3 name(VSS))

  # Devices and their connections
  device(1 SG13_HV_NMOS
   name(OA_MCS_MCS_0)
   param(L 30)
   param(W 3.4)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 3)
   terminal(G 1)
   terminal(D 1)
   terminal(B 3)
  )
  device(2 SG13_HV_NMOS
   name(OA_MCS_MCL_1)
   param(L 30)
   param(W 3.4)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 3)
   terminal(G 1)
   terminal(D 2)
   terminal(B 3)
  )

 )
)

# Cross reference
xref(
 circuit(oa_mcs oa_mcs match
  xref(
   net(2 1 match)
   net(3 2 match)
   net(1 3 match)
   pin(() 0 match)
   pin(() 1 match)
   pin(() 2 match)
   pin(0 () match)
   pin(1 () match)
   pin(2 () match)
   device(2 1 match)
   device(1 2 match)
  )
 )
)
