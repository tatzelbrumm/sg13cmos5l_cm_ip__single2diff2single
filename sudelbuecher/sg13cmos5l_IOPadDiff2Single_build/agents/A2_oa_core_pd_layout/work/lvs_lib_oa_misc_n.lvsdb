# Reference netlist
reference(

 # Device class section
 class(SG13_HV_NMOS MOS4)

 # Circuit section
 # Circuits are the hierarchical building blocks of the netlist.
 circuit(oa_misc_n

  # Nets
  net(1 name(D10))
  net(2 name(EN_3V3_B))
  net(3 name(KS))
  net(4 name(VBR))
  net(5 name(VPC))
  net(6 name(VSS))

  # Outgoing pins and their connections to nets
  pin(1 name(D10))
  pin(2 name(EN_3V3_B))
  pin(3 name(KS))
  pin(4 name(VBR))
  pin(5 name(VPC))
  pin(6 name(VSS))

  # Devices and their connections
  device(1 SG13_HV_NMOS
   name(OA_MISC_N_MC10_0)
   param(L 1)
   param(W 10)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 1)
   terminal(G 4)
   terminal(D 5)
   terminal(B 6)
  )
  device(2 SG13_HV_NMOS
   name(OA_MISC_N_MS2_1)
   param(L 1)
   param(W 10)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
