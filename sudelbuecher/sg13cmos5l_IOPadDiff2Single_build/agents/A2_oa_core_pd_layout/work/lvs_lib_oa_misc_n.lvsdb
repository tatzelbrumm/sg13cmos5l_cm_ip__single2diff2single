   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 6)
   terminal(G 2)
   terminal(D 3)
   terminal(B 6)
  )

 )
)

# Cross reference
xref(
 circuit(oa_misc_n oa_misc_n match
  xref(
   net(2 1 match)
   net(6 2 match)
   net(4 3 match)
   net(5 4 match)
   net(3 5 match)
   net(1 6 match)
   pin(() 0 match)
   pin(() 1 match)
   pin(() 2 match)
   pin(() 3 match)
   pin(() 4 match)
   pin(() 5 match)
   pin(0 () match)
   pin(1 () match)
   pin(2 () match)
   pin(3 () match)
   pin(4 () match)
   pin(5 () match)
   device(4 1 match)
   device(3 2 match)
   device(2 3 match)
   device(1 4 match)
  )
 )
)
