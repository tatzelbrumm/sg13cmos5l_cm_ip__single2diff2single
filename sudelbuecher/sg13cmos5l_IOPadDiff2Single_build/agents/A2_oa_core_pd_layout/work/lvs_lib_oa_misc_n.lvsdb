  terminal(S
   rect(nsd_sd (-840 -5000) (340 10000))
  )
  terminal(G
   rect(poly (-500 -5000) (1000 10000))
  )
  terminal(D
   rect(nsd_sd (500 -5000) (340 10000))
  )
  terminal(B
   rect(sub (-500 -5000) (1000 10000))
  )
 )

