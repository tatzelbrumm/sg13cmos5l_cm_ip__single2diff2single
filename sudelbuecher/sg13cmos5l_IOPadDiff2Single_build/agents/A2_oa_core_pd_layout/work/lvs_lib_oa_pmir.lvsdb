#%lvsdb-klayout

# Layout
layout(
 top(oa_pmir)
 unit(0.001)

 # Layer section
 # This section lists the mask layers (drawing or derived) and their connections.

 # Mask layers
 layer(poly '5/0')
 layer(cont '6/0')
 layer(m1 '8/0')
 layer(v1 '19/0')
 layer(m2 '10/0')
 layer(nw '31/0')
 layer(t8 '8/25')
 layer(sub)
 layer(psd_sd)
 layer(nsd_sd)
 layer(ntap)
 layer(ptap)
 layer(t10 '10/25')

 # Mask layer connectivity
 connect(poly poly cont)
 connect(cont poly m1 psd_sd nsd_sd ntap ptap)
 connect(m1 cont m1 v1 t8)
 connect(v1 m1 m2)
 connect(m2 v1 m2 t10)
 connect(nw nw ntap)
 connect(t8 m1)
 connect(sub sub ptap)
 connect(psd_sd cont psd_sd)
 connect(nsd_sd cont nsd_sd)
 connect(ntap cont nw ntap)
 connect(ptap cont sub ptap)
 connect(t10 m2)

 # Device class section
 class(sg13_hv_pmos MOS4)
 class(sg13_hv_nmos MOS4)

 # Device abstracts section
 # Device abstracts list the pin shapes of the devices.
 device(D$sg13_hv_pmos sg13_hv_pmos
  terminal(S
   rect(psd_sd (-1000 -4340) (2000 340))
  )
  terminal(G
   rect(poly (-1000 -4000) (2000 8000))
  )
  terminal(D
   rect(psd_sd (-1000 4000) (2000 340))
  )
  terminal(B
   rect(nw (-1000 -4000) (2000 8000))
  )
 )

