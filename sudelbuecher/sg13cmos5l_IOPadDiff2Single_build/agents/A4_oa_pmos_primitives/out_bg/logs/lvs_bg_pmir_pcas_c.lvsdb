#%lvsdb-klayout

# Layout
layout(
 top(bg_pmir_pcas_c)
 unit(0.001)

 # Layer section
 # This section lists the mask layers (drawing or derived) and their connections.

 # Mask layers
 layer(poly '5/0')
 layer(cont '6/0')
 layer(m1 '8/0')
 layer(v1 '19/0')
 layer(m2 '10/0')
 layer(nw '31/0')
 layer(sub)
 layer(t8 '8/25')
 layer(psd_sd)
 layer(nsd_sd)
 layer(ntap)
 layer(ptap)

 # Mask layer connectivity
 connect(poly poly cont)
 connect(cont poly m1 psd_sd nsd_sd ntap ptap)
 connect(m1 cont m1 v1 t8)
 connect(v1 m1 m2)
 connect(m2 v1 m2)
 connect(nw nw ntap)
 connect(sub sub ptap)
 connect(t8 m1)
 connect(psd_sd cont psd_sd)
 connect(nsd_sd cont nsd_sd)
 connect(ntap cont nw ntap)
 connect(ptap cont sub ptap)

 # Device class section
 class(sg13_hv_pmos MOS4)
 class(sg13_hv_nmos MOS4)

 # Device abstracts section
 # Device abstracts list the pin shapes of the devices.
 device(D$sg13_hv_pmos sg13_hv_pmos
  terminal(S
   rect(psd_sd (-150 -840) (300 340))
  )
  terminal(G
   rect(poly (-150 -500) (300 1000))
  )
  terminal(D
   rect(psd_sd (-150 500) (300 340))
  )
  terminal(B
   rect(nw (-150 -500) (300 1000))
  )
 )
 device(D$sg13_hv_pmos$1 sg13_hv_pmos
  terminal(S
   rect(psd_sd (-5000 -840) (10000 340))
  )
  terminal(G
   rect(poly (-5000 -500) (10000 1000))
  )
  terminal(D
   rect(psd_sd (-5000 500) (10000 340))
  )
  terminal(B
   rect(nw (-5000 -500) (10000 1000))
  )
 )

