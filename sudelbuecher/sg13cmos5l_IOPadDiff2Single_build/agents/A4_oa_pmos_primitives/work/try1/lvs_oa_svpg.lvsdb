#%lvsdb-klayout

# Layout
layout(
 top(oa_svpg)
 unit(0.001)

 # Layer section
 # This section lists the mask layers (drawing or derived) and their connections.

 # Mask layers
 layer(poly '5/0')
 layer(cont '6/0')
 layer(m1 '8/0')
 layer(v1 '19/0')
 layer(m2 '10/0')
 layer(nw '31/0')
 layer(sub)
 layer(t8 '8/25')
 layer(psd_sd)
 layer(nsd_sd)
 layer(ntap)
 layer(ptap)
 layer(t10 '10/25')

 # Mask layer connectivity
 connect(poly poly cont)
 connect(cont poly m1 psd_sd nsd_sd ntap ptap)
 connect(m1 cont m1 v1 t8)
 connect(v1 m1 m2)
 connect(m2 v1 m2 t10)
 connect(nw nw ntap)
 connect(sub sub ptap)
 connect(t8 m1)
 connect(psd_sd cont psd_sd)
 connect(nsd_sd cont nsd_sd)
 connect(ntap cont nw ntap)
 connect(ptap cont sub ptap)
 connect(t10 m2)

 # Device class section
 class(sg13_hv_pmos MOS4)
 class(sg13_hv_nmos MOS4)

 # Device abstracts section
 # Device abstracts list the pin shapes of the devices.
 device(D$sg13_hv_pmos sg13_hv_pmos
  terminal(S
   rect(psd_sd (-500 -565) (1000 340))
  )
  terminal(G
   rect(poly (-500 -225) (1000 450))
  )
  terminal(D
   rect(psd_sd (-500 225) (1000 340))
  )
  terminal(B
   rect(nw (-500 -225) (1000 450))
  )
 )

 # Circuit section
 # Circuits are the hierarchical building blocks of the netlist.
 circuit(oa_svpg

  # Circuit boundary
  rect((-20620 -20620) (42240 42370))

  # Nets with their geometries
  net(1 name(en_3v3)
   rect(poly (1000 340) (410 450))
   rect(poly (-1590 -450) (1360 450))
   rect(cont (0 -305) (160 160))
   rect(m1 (-160 -210) (440 260))
   text(t8 en_3v3 (-125 -130))
  )
  net(2 name(vdd)
   rect(cont (70 900) (160 160))
   rect(cont (190 -160) (160 160))
   rect(cont (190 -160) (160 160))
   rect(m1 (-930 -160) (1000 850))
   rect(m1 (-1000 -850) (1000 160))
   text(t8 vdd (-500 540))
   rect(psd_sd (-500 -810) (1000 340))
  )
  net(3 name(vpg)
   rect(cont (70 70) (160 160))
   rect(cont (190 -160) (160 160))
   rect(cont (190 -160) (160 160))
   rect(m1 (-930 -850) (1000 850))
   rect(m1 (-1000 -160) (1000 160))
   text(t8 vpg (-500 -700))
   rect(psd_sd (-500 470) (1000 340))
  )
  net(4 name($4)
   rect(nw (-620 -620) (2240 2370))
   rect(nw (-2240 -2370) (2240 2370))
  )
  net(5 name($5)
   polygon(sub (-20620 -20620) (0 22370) (20000 0) (0 -2370) (2240 0) (0 2370) (-22240 0) (0 20000) (42240 0) (0 -42370))
  )

  # Outgoing pins and their connections to nets
  pin(name(EN_3V3))
  pin(name(VDD))
  pin(name(VPG))

  # Devices and their connections
  device(1 D$sg13_hv_pmos
   location(500 565)
   param(L 0.45)
   param(W 1)
   param(AS 0.34)
   param(AD 0.34)
   param(PS 2.68)
   param(PD 2.68)
   terminal(S 3)
   terminal(G 1)
   terminal(D 2)
   terminal(B 4)
  )

 )
)

# Reference netlist
reference(

 # Device class section
 class(SG13_HV_PMOS MOS4)

 # Circuit section
 # Circuits are the hierarchical building blocks of the netlist.
 circuit(oa_svpg

  # Nets
  net(1 name(EN_3V3))
  net(2 name(VDD))
  net(3 name(VPG))
  net(4 name(NW))

  # Outgoing pins and their connections to nets
  pin(1 name(EN_3V3))
  pin(2 name(VDD))
  pin(3 name(VPG))

  # Devices and their connections
  device(1 SG13_HV_PMOS
   name(OA_SVPG_SVPG)
   param(L 0.45)
   param(W 1)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 2)
   terminal(G 1)
   terminal(D 3)
   terminal(B 4)
  )

 )
)

# Cross reference
xref(
 circuit(oa_svpg oa_svpg match
  xref(
   net(4 4 match)
   net(1 1 match)
   net(2 2 match)
   net(3 3 match)
   pin(() 0 match)
   pin(() 1 match)
   pin(() 2 match)
   pin(0 () match)
   pin(1 () match)
   pin(2 () match)
   device(1 1 match)
  )
 )
)
