+def replica_plan(ng, l, x0, mode, at='centre', side=None):
+    """Which drain column and gates form the replica (gate i sits next to drain i // 2).
+    mode 'pair'  : both gates of drain k, S-G-D-G-S, no dummy (needs two gates at k).
+    mode 'single': one gate of drain k; the other gate of that drain (if any: the
+                   0.74 um end drain of an odd ng has only one) becomes a dummy.
+    at   : 'centre' - pair: the drain nearest to the array centre; single: the gate
+                      nearest to it (ties: the left one)
+           'end'    - the last drain column (right end of the array)
+           int      - drain column index k, 0 = leftmost
+    side : single with at = 'end' / int: 'L' or 'R' gate of drain k; default the one
+           nearer to the array centre.
+    Returns dict(mode, k, rep=[gate indices], dummy=[gate indices])."""
+    if mode not in ('pair', 'single'):
+        raise ClampError("rep must be None, 'pair' or 'single'")
+    xa0, xa1 = array_extent(ng, l, x0)
+    g = gate_lefts(ng, l, x0)
+    _, drn = columns(ng, l, x0)
+    xm2 = xa0 + xa1                                   # 2 x array centre (exact)
+    gc2 = [2 * gl + l for gl in g]                    # 2 x gate centres
+    gates = lambda k: [i for i in (2 * k, 2 * k + 1) if i < ng]
+    if at == 'centre':
+        if mode == 'pair':
+            ks = [k for k in range(len(drn)) if len(gates(k)) == 2]
+            if not ks:
+                raise ClampError('ng = %d: no drain column with two gates' % ng)
+            k = min(ks, key=lambda k: (abs(2 * drn[k] - xm2), k))
+        else:
+            i = min(range(ng), key=lambda i: (abs(gc2[i] - xm2), i))
+            k, side = i // 2, 'L' if i % 2 == 0 else 'R'
+    elif at == 'end':
+        k = len(drn) - 1
+    else:
+        k = int(at)
+        if not 0 <= k < len(drn):
+            raise ClampError('replica drain column %d does not exist (0 .. %d)' % (k, len(drn) - 1))
+    gk = gates(k)
+    if mode == 'pair':
+        if len(gk) != 2:
+            raise ClampError('drain column %d has one gate only: no S-G-D-G-S pair' % k)
+        rep, dummy = gk, []
+    else:
+        if side is None:
+            side = 'L' if len(gk) == 1 or abs(gc2[gk[0]] - xm2) <= abs(gc2[gk[1]] - xm2) else 'R'
+        if side not in ('L', 'R') or (side == 'R' and len(gk) == 1):
+            raise ClampError('replica side must be L or R (R needs a second gate at drain %d)' % k)
+        rep = [gk[0] if side == 'L' else gk[1]]
+        dummy = [i for i in gk if i not in rep]
+    if len(rep) + len(dummy) >= ng:
+        raise ClampError('ng = %d: no output finger left besides the replica' % ng)
+    return dict(mode=mode, k=k, rep=rep, dummy=dummy)
+
