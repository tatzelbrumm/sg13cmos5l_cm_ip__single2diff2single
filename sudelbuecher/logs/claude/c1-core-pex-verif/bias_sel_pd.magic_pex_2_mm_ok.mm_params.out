cd verification/cace && test -f templates/cores/magic_pex_2_mm_ok.spice && mkdir -p results/bias_sel_pd_cores_magic_pex_2_mm_ok && status=0 && \
if [ _bias_sel_pd_cores.yaml != bias_sel_pd.yaml ]; then \
  sed '/^  cores:/,/typical:/s/typical: schematic/typical: magic_pex_2_mm_ok/' bias_sel_pd.yaml > _bias_sel_pd_cores.yaml ; \
fi && \
for g in mm_params; do \
  rm -rf _runs/RUN_* ; \
  cace _bias_sel_pd_cores.yaml -s schematic -p $g -j 3 --no-progress-bar || status=1 ; \
  cp _runs/RUN_*/parameters/$g/*.png results/bias_sel_pd_cores_magic_pex_2_mm_ok/ 2>/dev/null ; \
  cp _runs/RUN_*/summary.md results/bias_sel_pd_cores_magic_pex_2_mm_ok/summary_$g.md ; \
  python3 /home/user/sg13cmos5l_cm_ip__single2diff2single/macros/bias_sel_pd/../../scripts/cace/cace_to_csv.py bias_sel_pd.yaml $g _runs/RUN_* results/bias_sel_pd_cores_magic_pex_2_mm_ok/$g.csv || status=1 ; \
  n=$(grep -lE 'Transient op started|Timestep too small' _runs/RUN_*/parameters/$g/run_*/ngspice_std*.out 2>/dev/null | wc -l) ; \
  [ $n -eq 0 ] || echo "WARNING: $g: $n runs where ngspice fell back to a transient op or stopped at timestep too small" ; \
  rm -rf _runs/RUN_* ; \
done ; \
rm -rf _runs _docs netlist _bias_sel_pd_cores.yaml ; exit ${status:-1}
