#%lvsdb-klayout

# Layout
layout(
 top(bg_core_pd)
 unit(0.001)

 # Layer section
 # This section lists the mask layers (drawing or derived) and their connections.

 # Mask layers
 layer(cont '6/0')
 layer(m1 '8/0')
 layer(v1 '19/0')
 layer(m2 '10/0')
 layer(nw '31/0')
 layer(poly_c)
 layer(pnp_tc)
 layer(psd_sd)
 layer(nsd_sd)
 layer(ntap)
 layer(ptap)
 layer(pnp_b)
 layer(pnp_e)
 layer(sub)
 layer(t8 '8/25')
 layer(t10 '10/25')

 # Mask layer connectivity
 connect(cont m1 poly_c psd_sd nsd_sd ntap ptap)
 connect(m1 cont m1 v1 t8)
 connect(v1 m1 m2)
 connect(m2 v1 m2 t10)
 connect(nw nw ntap pnp_b)
 connect(poly_c cont poly_c)
 connect(pnp_tc pnp_tc)
 connect(psd_sd cont psd_sd pnp_e)
 connect(nsd_sd cont nsd_sd)
 connect(ntap cont nw ntap)
 connect(ptap cont ptap sub)
 connect(pnp_b nw pnp_b)
 connect(pnp_e psd_sd pnp_e)
 connect(sub ptap sub)
 connect(t8 m1)
 connect(t10 m2)

 # Global nets and connectivity
 global(pnp_tc SUBSTRATE)
 global(sub SUBSTRATE)

 # Device class section
 class(sg13_hv_pmos MOS4)
 class(sg13_hv_nmos MOS4)
 class(RES RES)
 class(PNPMPA BJT3)

