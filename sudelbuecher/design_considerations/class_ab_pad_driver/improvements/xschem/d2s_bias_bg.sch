P 10 5 120 -1070 340 -1070 340 -115 120 -115 120 -1070 {dash=6}
P 10 5 820 -1070 960 -1070 960 -115 820 -115 820 -1070 {dash=6}
P 10 5 360 -1070 800 -1070 800 -115 360 -115 360 -1070 {dash=6}
