** sch_path: /foss/designs/sg13cmos5l_cm_ip__single2diff2single_sudelbuecher/sudelbuecher/design_considerations/class_ab_pad_driver/improvements/xschem/tb_lc2_loop.sch
**.subckt tb_lc2_loop
Vdd vdd GND 3.3
Vcm vref GND 1.65
Xb vdd GND vbp vbn vbpc vbnc vabp vabn d2s_bias_lp
Xd vdd GND vinp vinn vref vout fb vbp vbn vbpc vbnc vabp vabn d2s_lc2
Vp vinp GND 1.65
Vn vinn GND 1.65
Rs vout pad 586.9
Cpad pad GND 2p
CL pad GND 100p
Lb vout fb 1G
Cb fb inj 1
Vinj inj GND dc 0 ac 1
**** begin user architecture code

.lib cornerMOShv.lib mos_tt
.lib cornerRES.lib res_typ
.lib cornerCAP.lib cap_typ
.control
ac dec 50 10 1G
let T=-v(vout)/v(fb)
meas ac T0 find vdb(T) at=10
meas ac fc when vdb(T)=0
meas ac pT find vp(T) when vdb(T)=0
let pm=180/pi*pT+180
print T0 fc pm
if $?batchmode = 0
  plot vdb(T) 180/pi*vp(T)
end
.endc

**** end user architecture code
**.ends

