** sch_path: /foss/designs/sg13cmos5l_cm_ip__single2diff2single_sudelbuecher/sudelbuecher/design_considerations/class_ab_pad_driver/improvements/xschem/tb_mpdda_step.sch
**.subckt tb_mpdda_step
Vdd vdd GND 3.3
Vcm vref GND 1.65
Xb vdd GND vbp vbn vbpc vbnc vabp vabn d2s_bias_lp
Xd vdd GND vinp vinn vref vout vout vbp vbn vbpc vbnc vabp vabn d2s_mpdda
Vd dp GND pulse({-vstep} {vstep} 1u 1n 1n 4u 8u)
Ep vinp vref dp GND 0.5
En vinn vref dp GND -0.5
RL vout vref 1k
CL vout GND 1000p
**** begin user architecture code

.lib cornerMOShv.lib mos_tt
.lib cornerRES.lib res_typ
.lib cornerCAP.lib cap_typ
.param vstep=0.5
.control
tran 2n 9u
meas tran vlo find v(vout) at=0.99u
meas tran vhi find v(vout) at=4.9u
meas tran vmax max v(vout) from=1u to=5u
let os = 100*(vmax - vhi)/(vhi - vlo)
let v10 = vlo + 0.1*(vhi - vlo)
let v90 = vlo + 0.9*(vhi - vlo)
meas tran t10 when v(vout)=v10 rise=1
meas tran t90 when v(vout)=v90 rise=1
let rate = 0.8*(vhi - vlo)/(t90 - t10)
print vlo vhi os rate
if $?batchmode = 0
  plot v(vout) v(vinp) v(vinn)
end
.endc

**** end user architecture code
**.ends

