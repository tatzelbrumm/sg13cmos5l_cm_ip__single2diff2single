P 10 5 120 -1070 350 -1070 350 -115 120 -115 120 -1070 {dash=6}
P 10 5 370 -1070 860 -1070 860 -115 370 -115 370 -1070 {dash=6}
P 10 5 880 -1070 1020 -1070 1020 -115 880 -115 880 -1070 {dash=6}
P 10 5 1440 -1070 1740 -1070 1740 -115 1440 -115 1440 -1070 {dash=6}
P 10 5 1280 -1070 1420 -1070 1420 -115 1280 -115 1280 -1070 {dash=6}
