# xschemrc for working across all macros of sg13cmos5l_cm_ip__single2diff2single (2026-10-22).
# Each macro's own xschemrc only sees that macro (plus listed dependencies); this one puts the
# schematic/xschem directory of EVERY macro on the library path, so any sheet can place or
# descend into any other macro's symbol.
#
# Use:  cd macros && xschem                      (xschem reads ./xschemrc)
#   or: xschem --rcfile <repo>/macros/xschemrc <file.sch>
# New macros are picked up automatically (glob below, repeated on every file load); nothing to edit when one is added.
# Symbol names must be unique across macros: on a clash the alphabetically first macro wins.

# Set default PDK_ROOT
if { ![info exists env(PDK_ROOT)] } {
  puts stderr "Warning: PDK_ROOT env. var. not found or empty, trying to find an open_pdks install"
  if {[file isdir /usr/share/pdk]} {set ::env(PDK_ROOT) /usr/share/pdk
  } elseif {[file isdir /usr/local/share/pdk]} {set ::env(PDK_ROOT) /usr/local/share/pdk
  } elseif {[file isdir $env(HOME)/share/pdk]} {set ::env(PDK_ROOT) $env(HOME)/share/pdk
  } elseif {[file isdir $env(HOME)/.ciel]} {set ::env(PDK_ROOT) $env(HOME)/.ciel
  } elseif {[file isdir $env(HOME)/.volare]} {set ::env(PDK_ROOT) $env(HOME)/.volare
  } else {
    puts stderr {No open_pdks installation found, set PDK_ROOT env. var. and restart xschem}
  }
}

# Set default PDK
if { ![info exists env(PDK)] } {
  set ::env(PDK) ihp-sg13cmos5l
}

# Source the PDK xschemrc file
if {![info exists PDK]} {
    source $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
}

# Append a library path only if not already present.
if {![llength [info commands append_xschem_library_path_unique]]} {
  proc append_xschem_library_path_unique {path} {
    set normalized [file normalize $path]
    if {![info exists ::XSCHEM_LIBRARY_PATH]} {
      set ::XSCHEM_LIBRARY_PATH $normalized
      return
    }
    set entries [split $::XSCHEM_LIBRARY_PATH :]
    if {[lsearch -exact $entries $normalized] < 0} {
      if {$::XSCHEM_LIBRARY_PATH eq ""} {
        set ::XSCHEM_LIBRARY_PATH $normalized
      } else {
        append ::XSCHEM_LIBRARY_PATH :$normalized
      }
    }
  }
}

# Cross-reference rc for all macros (2026-10-22).
# Puts every macros/*/schematic/xschem, then every macros/*/testbenches/xschem, then the
# top cell's schematic/ and testbenches/ folders on the library path, so any sheet can
# place and descend into any macro's symbol. Located by this file's own path, so it works
# from any start directory:   cd <repo>/macros && xschem
#                       or   xschem --rcfile <repo>/macros/xschemrc
# Per-macro xschemrc files stay self-contained and are not sourced here.
set macros_root [file dirname [file normalize [info script]]]
# The macro list is read again on every file load (load_file_postprocess below), so a macro created while xschem runs
# is found without a restart (2026-10-28).
proc add_macro_paths {} {
  foreach sub {schematic/xschem testbenches/xschem} {
    foreach d [lsort [glob -nocomplain -type d [file join $::macros_root * $sub]]] {
      append_xschem_library_path_unique $d
    }
  }
}
add_macro_paths
append_xschem_library_path_unique [file join $macros_root .. schematic xschem]
append_xschem_library_path_unique [file join $macros_root .. testbenches xschem]

# Pin the netlist directory to the simulations folder of the loaded schematic
if {![llength [info commands pin_netlist_dir]]} {
  proc pin_netlist_dir {dir} {
    set dir [file normalize $dir]
    if {[string match */schematic/xschem $dir]} {
      # testbenches/xschem/simulations if the macro has testbenches, else schematic/xschem/simulations (both gitignored)
      set tb [file normalize [file join $dir ../../testbenches/xschem]]
      if {[file isdir $tb]} {set dir $tb}
    } elseif {![string match */testbenches/xschem $dir] && ![string match */cace/templates $dir]} {
      return
    }
    set ::netlist_dir [file normalize [file join $dir simulations]]
    # xschem does not create a netlist_dir set this way; without the folder netlisting fails
    catch {file mkdir $::netlist_dir}
  }
}
pin_netlist_dir [file dirname [info script]]
set load_file_postprocess {add_macro_paths; pin_netlist_dir [xschem get current_dirname]}
