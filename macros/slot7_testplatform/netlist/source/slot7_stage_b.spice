XNB7 en7_b en7 vss_3v3 vss_3v3 sg13_hv_nmos w=1u l=0.45u ng=1
XPA8 en8 xb8 vdd_3v3 vdd_3v3 sg13_hv_pmos w=1u l=0.45u ng=1
XNA8 en8 xb8 vss_3v3 vss_3v3 sg13_hv_nmos w=1u l=0.45u ng=1
XPB8 en8_b en8 vdd_3v3 vdd_3v3 sg13_hv_pmos w=1u l=0.45u ng=1
XNB8 en8_b en8 vss_3v3 vss_3v3 sg13_hv_nmos w=1u l=0.45u ng=1
.ends tp_en_ctrl_b

* slot7_stage_b: tree, reference select, bias-voltage mux, ibias1 path. i_oa / i_bg: the cores' outputs (stage A nets).
.subckt slot7_stage_b vdd_3v3 vss_3v3 vdd_1v2 enable dig_in[4] dig_in[5] dig_in[6] dig_in[7] dig_in[8] dig_in[9]
+ dig_in[10] dig_in[11] dig_in[12] i_oa i_bg ibias0 ibias1 analog_bus2 analog_bus3
xctlb vdd_3v3 vss_3v3 vdd_1v2 dig_in[4] dig_in[5] dig_in[6] dig_in[7] dig_in[8] dig_in[9] dig_in[10] dig_in[11]
+ dig_in[12] enable en_ref_oa en_ref_oa_b en_ref_bg en_ref_bg_b en_ref_ib0 en_ref_ib0_b en_tree en_tree_b
+ en_m_vbp en_m_vbp_b en_m_vbn en_m_vbn_b en_m_vbpc en_m_vbpc_b en_m_vbnc en_m_vbnc_b en_ib1 en_ib1_b tp_en_ctrl_b
* reference select (xgate: ena_b vdd in out vss ena)
xr_oa en_ref_oa_b vdd_3v3 i_oa iref vss_3v3 en_ref_oa xgate
xr_bg en_ref_bg_b vdd_3v3 i_bg iref vss_3v3 en_ref_bg xgate
xr_ib0 en_ref_ib0_b vdd_3v3 ibias0 iref vss_3v3 en_ref_ib0 xgate
* the tree (as in the S2D pad)
xtree vdd_3v3 vss_3v3 iref vbp vbn vbpc vbnc en_tree en_tree_b bias_tree_noab_pd
* bias-voltage mux onto analog_bus2
xm_vbp en_m_vbp_b vdd_3v3 vbp analog_bus2 vss_3v3 en_m_vbp xgate
xm_vbn en_m_vbn_b vdd_3v3 vbn analog_bus2 vss_3v3 en_m_vbn xgate
xm_vbpc en_m_vbpc_b vdd_3v3 vbpc analog_bus2 vss_3v3 en_m_vbpc xgate
xm_vbnc en_m_vbnc_b vdd_3v3 vbnc analog_bus2 vss_3v3 en_m_vbnc xgate
* harness ibias1 onto analog_bus3
xi_ib1 en_ib1_b vdd_3v3 ibias1 analog_bus3 vss_3v3 en_ib1 xgate
.ends slot7_stage_b

* slot7_testplatform_ab: stage A (its five instances, as in slot7_testplatform) + stage B. Ports = the slot pins used.
.subckt slot7_testplatform_ab vdd_3v3 vss_3v3 vdd_1v2 vss_1v2 enable dig_in[0] dig_in[1] dig_in[2] dig_in[3]
+ dig_in[4] dig_in[5] dig_in[6] dig_in[7] dig_in[8] dig_in[9] dig_in[10] dig_in[11] dig_in[12]
+ dig_out[0] dig_out[1] dig_out[2] dig_out[3] dig_out[4] dig_out[5] dig_out[6] dig_out[7] dig_out[8]
+ dig_out[9] dig_out[10] dig_out[11] analog_bus0 analog_bus1 analog_bus2 analog_bus3 ibias0 ibias1
xctl vdd_3v3 vss_3v3 vdd_1v2 vss_1v2 dig_in[0] dig_in[1] dig_in[2] dig_in[3] enable en_oa en_oa_b en_bg en_bg_b
+ en_tg0 en_tg0_b en_tg1 en_tg1_b dig_out[0] dig_out[1] dig_out[2] dig_out[3] dig_out[4] dig_out[5] dig_out[6]
+ dig_out[7] dig_out[8] dig_out[9] dig_out[10] dig_out[11] tp_en_ctrl
xoa vdd_3v3 vss_3v3 i_oa en_oa en_oa_b oa_core_pd
xbg vdd_3v3 vss_3v3 i_bg en_bg en_bg_b bg_core_pd
xtg0 en_tg0_b vdd_3v3 i_oa analog_bus0 vss_3v3 en_tg0 xgate
xtg1 en_tg1_b vdd_3v3 i_bg analog_bus1 vss_3v3 en_tg1 xgate
xb vdd_3v3 vss_3v3 vdd_1v2 enable dig_in[4] dig_in[5] dig_in[6] dig_in[7] dig_in[8] dig_in[9] dig_in[10]
+ dig_in[11] dig_in[12] i_oa i_bg ibias0 ibias1 analog_bus2 analog_bus3 slot7_stage_b
.ends slot7_testplatform_ab
